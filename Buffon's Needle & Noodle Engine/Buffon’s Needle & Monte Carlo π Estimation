        </span>
      </div>
      <div class="canvas-wrapper">
        <canvas id="canvasField"></canvas>
      </div>
    </div>

    <!-- Right Canvas -->
    <div class="canvas-panel">
      <div class="panel-header">
        <span>Figure 2: Empirical &pi; Convergence &amp; 95% CLT Envelope</span>
        <span class="legend-span">
          <span style="color: var(--pi-ref-color); font-weight: bold;">-- &pi; (3.1416)</span> | 
          <span style="color: var(--trace-color); font-weight: bold;">&#9644; &pi;̂</span> | 
          <span style="color: #94a3b8;">::: 95% CLT</span>
